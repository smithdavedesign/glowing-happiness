<?xml version="1.0" encoding="UTF-8"?>
<jcr:root
        xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
        xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
        xmlns:cq="http://www.day.com/jcr/cq/1.0"
        xmlns:jcr="http://www.jcp.org/jcr/1.0"
        xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
        jcr:primaryType="nt:unstructured"
        jcr:title="Product Overview"
        sling:resourceType="cq/gui/components/authoring/dialog">
        <content
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                        <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                        <column
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                                <items jcr:primaryType="nt:unstructured">
                                                        <description
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                                jcr:primaryType="nt:unstructured"
                                                                required="{Boolean}true"
                                                                name="./description"
                                                                fieldLabel="Description"
                                                                rows="{Long}5" />
                                                        <extraInfo
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                                jcr:primaryType="nt:unstructured"
                                                                name="./extraInfo"
                                                                fieldLabel="Extra Info"
                                                                fieldDescription="Optional information to be displayed separately from the product description. E.g. Formerly manufactured by Intel Corporation"
                                                                rows="{Long}3" />
                                                        <distributorPage
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                                name="./distributorPage"
                                                                fieldLabel="Authorized Distributor Link"
                                                                fieldDescription="Optional authorized dealer field to change from default destination of authorized-dealers"
                                                                rootPath="/content/solidigm" />
                                                </items>
                                        </column>
                                </items>
                        </columns>
                </items>
        </content>
</jcr:root>