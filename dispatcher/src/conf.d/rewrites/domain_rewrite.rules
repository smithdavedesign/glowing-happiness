## Redirect all requests ending in /en.html that are not on .com
RewriteCond %{HTTP_HOST} !^(.*\.)?(solidigm|solidigmtechnology).com [NC]
RewriteCond %{REQUEST_URI} ^/en.html$
RewriteRule (.*) https://%1solidigm.com [L,R=301]

## Redirect all requests ending in /ko.html that are not on .kr
