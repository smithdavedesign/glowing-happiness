<?xml version="1.0" encoding="UTF-8"?>
<jcr:root
        xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
        xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
        xmlns:cq="http://www.day.com/jcr/cq/1.0"
        xmlns:jcr="http://www.jcp.org/jcr/1.0"
        xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
        jcr:primaryType="nt:unstructured"
        jcr:title="Hero"
        sling:resourceType="cq/gui/components/authoring/dialog">
    <content
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/tabs"
                    maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <text
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Text"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <title
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                    jcr:primaryType="nt:unstructured"
                                                    name="./title"
                                                    fieldLabel="Title"
                                                    rows="{Long}3" />
                                            <subtitle
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                    jcr:primaryType="nt:unstructured"
                                                    name="./subtitle"
                                                    fieldLabel="Subtitle"
                                                    rows="{Long}3" />
                                            <description
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                                    fieldLabel="Description"
                                                    name="./description"
                                                    useFixedInlineToolbar="{Boolean}true"
                                                    externalStyleSheets="[]">
                                                <rtePlugins jcr:primaryType="nt:unstructured">
                                                    <misctools
                                                            jcr:primaryType="nt:unstructured"
                                                            features="*">
                                                        <specialCharsConfig jcr:primaryType="nt:unstructured">
                                                            <chars jcr:primaryType="nt:unstructured">
                                                                <item_0
                                                                        jcr:primaryType="nt:unstructured"
                                                                        entity="&#169;"
                                                                        name="©" />
                                                            </chars>
                                                        </specialCharsConfig>
                                                    </misctools>
                                                </rtePlugins>
                                                <uiSettings jcr:primaryType="nt:unstructured">
                                                    <cui jcr:primaryType="nt:unstructured">
                                                        <inline
                                                                jcr:primaryType="nt:unstructured"
                                                                toolbar="[misctools#specialchars,misctools#sourceedit]">
                                                        </inline>
                                                    </cui>
                                                </uiSettings>
                                            </description>
                                            <breadcrumb
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                    fieldLabel="Show Breadcrumb"
                                                    fieldDescription="Select whether to show or hide the breadcrumb"
                                                    name="./breadcrumb"
                                                    sling:orderBefore="startLevel" >
                                                <items jcr:primaryType="nt:unstructured">
                                                    <item_0 jcr:primaryType="nt:unstructured"
                                                            text="Hide Breadcrumb"
                                                            value=""
                                                            selected="{Boolean}true" />
                                                    <item_1 jcr:primaryType="nt:unstructured"
                                                            text="Show Breadcrumb"
                                                            value="show_breadcrumb" />
                                                </items>
                                            </breadcrumb>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </text>
                    <images
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Images"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <headingDesktopImage
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/heading"
                                                    level="{Long}4"
                                                    text="Desktop Image" />
                                            <desktopImage
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                                    autoStart="{Boolean}false"
                                                    class="cq-droptarget"
                                                    fileNameParameter="./desktopImage"
                                                    fileReferenceParameter="./desktopImageReference"
                                                    mimeTypes="[image/gif,image/jpeg,image/png,image/tiff,image/svg+xml]"
                                                    name="./desktopImage"
                                                    uploadUrl="${suffix.path}"
                                                    useHTML5="{Boolean}true"
                                                    required="{Boolean}true" />
                                            <headingMobileImage
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/heading"
                                                    level="{Long}4"
                                                    text="Mobile Image" />
                                            <mobileImage
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                                    autoStart="{Boolean}false"
                                                    class="cq-droptarget"
                                                    fileNameParameter="./mobileImage"
                                                    fileReferenceParameter="./mobileImageReference"
                                                    mimeTypes="[image/gif,image/jpeg,image/png,image/tiff,image/svg+xml]"
                                                    name="./mobileImage"
                                                    uploadUrl="${suffix.path}"
                                                    useHTML5="{Boolean}true"
                                                    required="{Boolean}true" />
                                            <filter
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                    fieldLabel="Filter"
                                                    fieldDescription="Select a filter for the hero image"
                                                    name="./filter">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <item_0 jcr:primaryType="nt:unstructured"
                                                            text="No Filter"
                                                            value=""
                                                            selected="{Boolean}true" />
                                                    <item_1 jcr:primaryType="nt:unstructured"
                                                            text="Darken"
                                                            value="darken" />
                                                </items>
                                            </filter>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </images>
                    <links
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Links"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <callToActions
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                    composite="{Boolean}true"
                                                    fieldLabel="Call-To-Action Links">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    name="./callToActions">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <column
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                                        <items jcr:primaryType="nt:unstructured">
                                                            <callToAction
                                                                    jcr:primaryType="nt:unstructured"
                                                                    sling:resourceType="granite/ui/components/coral/foundation/form/fieldset"
                                                                    jcr:title="Call-To-Action Button">
                                                                <items jcr:primaryType="nt:unstructured">
                                                                    <buttonLabel
                                                                            jcr:primaryType="nt:unstructured"
                                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                            fieldLabel="Button Label"
                                                                            required="{Boolean}true"
                                                                            name="./buttonLabel" />
                                                                    <buttonLink
                                                                            jcr:primaryType="nt:unstructured"
                                                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                                            name="./buttonLink"
                                                                            fieldLabel="Button Link"
                                                                            fieldDescription="The link target for this Call-To-Action Button"
                                                                            rootPath="/content/solidigm"
                                                                            required="{Boolean}true" />
                                                                    <buttonStyle
                                                                            jcr:primaryType="nt:unstructured"
                                                                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                                            fieldLabel="Select Button Style"
                                                                            fieldDescription="Select a Button Style from the available options"
                                                                            name="./buttonStyle">
                                                                        <items jcr:primaryType="nt:unstructured">
                                                                            <item_0 jcr:primaryType="nt:unstructured"
                                                                                  text="Opaque"
                                                                                  value=""
                                                                                  selected="{Boolean}true" />
                                                                            <item_1 jcr:primaryType="nt:unstructured"
                                                                                  text="Transparent"
                                                                                  value="transparent" />
                                                                        </items>
                                                                    </buttonStyle>
                                                                </items>
                                                            </callToAction>
                                                        </items>
                                                    </column>
                                                </items>
                                                </field>
                                            </callToActions>
                                            <anchors
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                    composite="{Boolean}true"
                                                    fieldLabel="Anchor Links"
                                                    fieldDescription="List of buttons to anchors on the same page">
                                                <field
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/container"
                                                        name="./anchors">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <column
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <fieldset
                                                                        jcr:primaryType="nt:unstructured"
                                                                        sling:resourceType="granite/ui/components/coral/foundation/form/fieldset"
                                                                        jcr:title="Anchor Button">
                                                                    <items jcr:primaryType="nt:unstructured">
                                                                        <anchorLabel
                                                                                jcr:primaryType="nt:unstructured"
                                                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                                fieldLabel="Anchor Label"
                                                                                required="{Boolean}true"
                                                                                name="./anchorLabel" />
                                                                        <anchorID
                                                                                jcr:primaryType="nt:unstructured"
                                                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                                fieldDescription="Must match an Anchor ID on the page (do not include &apos;#&apos; in ID)"
                                                                                fieldLabel="Anchor ID"
                                                                                required="{Boolean}true"
                                                                                name="./anchorID" />
                                                                    </items>
                                                                </fieldset>
                                                            </items>
                                                        </column>
                                                    </items>
                                                </field>
                                            </anchors>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </links>
                    <breadcrumb
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Breadcrumb"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            sling:resourceSuperType="solidigm/components/breadcrumb/cq:dialog/content/items/tabs/items/properties"
                            margin="{Boolean}true"
                            sling:hideResource="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured">
                                        <items jcr:primaryType="nt:unstructured">
                                            <startLevel
                                                    jcr:primaryType="nt:unstructured"
                                                    value="2"/>
                                            <hideCurrent
                                                    jcr:primaryType="nt:unstructured"
                                                    value="{Boolean}true"/>
                                            <disableShadowing
                                                    jcr:primaryType="nt:unstructured"
                                                    value="{Boolean}true"/>
                                            <id
                                                    jcr:primaryType="nt:unstructured"
                                                    value=""/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </breadcrumb>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>