## enabled additional file extensions
## isolate specific filters into their own filter file
# Allow ZIP file on the site.
/0100 { /type "allow" /extension '(xsl|xlsx|zip|xml|txt)' /path "/content/*" }

# allow product compare selector to pass through
/0110 { /type "allow" /selectors '(productcompare)' /extension '(json)' }

/0111 { /type "allow" /method "POST" /url "*/saml_login" }

/0112 { /type "allow" /method "POST" /url "*/saml_logout" }

/0113 { /type "allow" /method "GET" /url "/bin/solidigm/isSignedIn" }

/0114 { /type "allow" /method "GET" /url "/bin/solidigm/signOut" }

/0115 { /type "allow" /method "GET" /url "/bin/solidigm/dynamicTilelist" }

/0116 {
    /auth_checker {
        /url "/bin/solidigm/permissionCheck"
        /filter {
            /0000 { /glob "*" /type "deny" }
            /0001 { /glob "/content/solidigm/language-masters/en/my-solidigm" /type "allow" }
            /0002 { /glob "/content/solidigm/language-masters/de/my-solidigm" /type "allow" }
            /0003 { /glob "/content/solidigm/language-masters/kr/my-solidigm" /type "allow" }
            /0004 { /glob "/content/solidigm/language-masters/ja/my-solidigm" /type "allow" }
            /0005 { /glob "/content/solidigm/language-masters/zn/my-solidigm" /type "allow" }
        }
        /headers {
            /0000 { /glob "*" /type "deny" }
            /0001 { /glob "Set-Cookie:*" /type "allow" }
        }
    }
}