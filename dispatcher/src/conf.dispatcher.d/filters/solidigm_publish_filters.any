## enabled additional file extensions
## isolate specific filters into their own filter file
# Allow ZIP file on the site.
/0100 { /type "allow" /method "GET" /extension '(xsl|xlsx|zip|xml|txt)' /path "/content/*" }

# allow product compare selector to pass through
/0110 { /type "allow" /method "GET" /selectors '(productcompare)' /extension '(json)' }

/0111 { /type "allow" /method "POST" /url "*/saml_login" }

/0112 { /type "allow" /method "POST" /url "*/saml_logout" }

/0113 { /type "allow" /method "GET" /url "/bin/solidigm/isSignedIn" }

/0114 { /type "allow" /method "GET" /url "/bin/solidigm/signOut" }

/0115 { /type "allow" /method "GET" /url "/bin/solidigm/dynamicTilelist" }

/0116 { /type "allow" /method "GET" /url "/bin/solidigm/permissionCheck" }

/0117 { /type "allow" /method "GET" /url "/bin/solidigm/productComparisonOverlay" }

/0118 { /type "allow" /method "GET" /url "/bin/solidigm/productComparison" }

/0119 { /type "allow" /method "GET" /url "/bin/solidigm/productConfigurator" }

/0120 { /type "allow" /method "GET" /url "/bin/solidigm/search" }

/0121 { /type "allow" /method "GET" /url "/bin/solidigm/taggedArticles" }

/0122 { /type "allow" /method "GET" /url "/bin/solidigm/modelList" }

/0123 { /type "allow" /method "GET" /url "/bin/solidigm/supportArticlesServlet" }

# Allow AEM WCM Core Components sitemaps
/0124 { /type "allow" /method "GET" /path "/content/*" /selectors '(sitemap-index|sitemap)' /extension "xml" }

/0125 { /type "allow" /method "GET" /url "/robots.txt" /extension "txt" }