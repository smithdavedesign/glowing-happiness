<?xml version="1.0" encoding="UTF-8"?>
<jcr:root
        xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
        xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
        xmlns:cq="http://www.day.com/jcr/cq/1.0"
        xmlns:jcr="http://www.jcp.org/jcr/1.0"
        xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
        jcr:primaryType="nt:unstructured"
        jcr:title="Footer"
        sling:resourceType="cq/gui/components/authoring/dialog">
    <content
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabview
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/tabs"
                    maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <search
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Search"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <searchTitle
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldDescription="The title to be displayed above the search box."
                                                    fieldLabel="Search Title"
                                                    name="./searchTitle" />
                                            <placeholderText
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldDescription="Placeholder text to be displayed within the search box before the user enters anything"
                                                    fieldLabel="Search Place Holder Text"
                                                    name="./placeholderText" />
                                            <searchResultsPage
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                    name="./searchResultsPage"
                                                    fieldLabel="Search Results Page"
                                                    fieldDescription="Path to the Search Results Page"
                                                    rootPath="/content/solidigm"
                                                    required="{Boolean}true" />
                                            <searchTags
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="cq/gui/components/coral/common/form/tagfield"
                                                    name="./searchTags"
                                                    fieldLabel="Tags"
                                                    fieldDescription="Selection of Tags that a user can search by with one click"
                                                    multiple="{Boolean}true"
                                                    rootPath="/content/cq:tags/solidigm" />
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </search>
                    <legal
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Legal"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <disclaimer
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                                    fieldLabel="Disclaimer"
                                                    name="./disclaimer"
                                                    useFixedInlineToolbar="{Boolean}true"
                                                    externalStyleSheets="[]">
                                                    <rtePlugins jcr:primaryType="nt:unstructured">
                                                        <misctools    
                                                                jcr:primaryType="nt:unstructured"    
                                                                features="*">    
                                                            <specialCharsConfig jcr:primaryType="nt:unstructured">    
                                                                <chars jcr:primaryType="nt:unstructured">    
                                                                    <item_0    
                                                                            jcr:primaryType="nt:unstructured"    
                                                                            entity="&#169;"    
                                                                            name="copyright" />
                                                                        <item_1    
                                                                            jcr:primaryType="nt:unstructured"    
                                                                            entity="&#174;"    
                                                                            name="registered" />    
                                                                    <item_2    
                                                                            jcr:primaryType="nt:unstructured"    
                                                                            entity="&#8482;"    
                                                                            name="trademark" />    
                                                                </chars>    
                                                            </specialCharsConfig>    
                                                        </misctools>    
                                                    </rtePlugins>    
                                                    <uiSettings jcr:primaryType="nt:unstructured">    
                                                        <cui jcr:primaryType="nt:unstructured">    
                                                            <inline    
                                                                    jcr:primaryType="nt:unstructured"    
                                                                    toolbar="[format#bold,format#italic,format#underline,#justify,#lists,links#modifylink,links#unlink,misctools#specialchars]">
                                                                </inline>    
                                                            <dialogFullScreen    
                                                                    jcr:primaryType="nt:unstructured"
                                                                    toolbar="[format#bold,format#italic,format#underline,justify#justifyleft,justify#justifycenter,justify#justifyright,lists#unordered,lists#ordered,lists#outdent,lists#indent,links#modifylink,links#unlink,link#anchor,misctools#specialchars]">
                                                                </dialogFullScreen>
                                                        </cui>
                                                    </uiSettings>
                                            </disclaimer>
                                            <trademark
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                                    fieldLabel="Trademark Text"
                                                    name="./trademark"
                                                    useFixedInlineToolbar="{Boolean}true"
                                                    externalStyleSheets="[]">
                                                <rtePlugins jcr:primaryType="nt:unstructured">
                                                    <misctools    
                                                            jcr:primaryType="nt:unstructured"    
                                                            features="*">    
                                                        <specialCharsConfig jcr:primaryType="nt:unstructured">    
                                                            <chars jcr:primaryType="nt:unstructured">    
                                                                <item_0    
                                                                        jcr:primaryType="nt:unstructured"    
                                                                        entity="&#169;"    
                                                                        name="copyright" />
                                                                    <item_1    
                                                                        jcr:primaryType="nt:unstructured"    
                                                                        entity="&#174;"    
                                                                        name="registered" />    
                                                                <item_2    
                                                                        jcr:primaryType="nt:unstructured"    
                                                                        entity="&#8482;"    
                                                                        name="trademark" />    
                                                            </chars>    
                                                        </specialCharsConfig>    
                                                    </misctools>    
                                                </rtePlugins>    
                                                <uiSettings jcr:primaryType="nt:unstructured">    
                                                    <cui jcr:primaryType="nt:unstructured">    
                                                        <inline    
                                                                jcr:primaryType="nt:unstructured"    
                                                                toolbar="[format#bold,format#italic,format#underline,#justify,#lists,links#modifylink,links#unlink,misctools#specialchars]">
                                                            </inline>    
                                                        <dialogFullScreen    
                                                                jcr:primaryType="nt:unstructured"
                                                                toolbar="[format#bold,format#italic,format#underline,justify#justifyleft,justify#justifycenter,justify#justifyright,lists#unordered,lists#ordered,lists#outdent,lists#indent,links#modifylink,links#unlink,link#anchor,misctools#specialchars]">
                                                            </dialogFullScreen>
                                                    </cui>
                                                </uiSettings>
                                            </trademark>
                                            <copyright
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                                    fieldLabel="Copyright Text"
                                                    name="./copyright"
                                                    useFixedInlineToolbar="{Boolean}true"
                                                    externalStyleSheets="[]">
                                                <rtePlugins jcr:primaryType="nt:unstructured">
                                                    <misctools    
                                                            jcr:primaryType="nt:unstructured"    
                                                            features="*">    
                                                        <specialCharsConfig jcr:primaryType="nt:unstructured">    
                                                            <chars jcr:primaryType="nt:unstructured">    
                                                                <item_0    
                                                                        jcr:primaryType="nt:unstructured"    
                                                                        entity="&#169;"    
                                                                        name="copyright" />
                                                                    <item_1    
                                                                        jcr:primaryType="nt:unstructured"    
                                                                        entity="&#174;"    
                                                                        name="registered" />    
                                                                <item_2    
                                                                        jcr:primaryType="nt:unstructured"    
                                                                        entity="&#8482;"    
                                                                        name="trademark" />    
                                                            </chars>    
                                                        </specialCharsConfig>    
                                                    </misctools>    
                                                </rtePlugins>    
                                                <uiSettings jcr:primaryType="nt:unstructured">    
                                                    <cui jcr:primaryType="nt:unstructured">    
                                                        <inline    
                                                                jcr:primaryType="nt:unstructured"    
                                                                toolbar="[format#bold,format#italic,format#underline,#justify,#lists,links#modifylink,links#unlink,misctools#specialchars]">
                                                            </inline>    
                                                        <dialogFullScreen    
                                                                jcr:primaryType="nt:unstructured"
                                                                toolbar="[format#bold,format#italic,format#underline,justify#justifyleft,justify#justifycenter,justify#justifyright,lists#unordered,lists#ordered,lists#outdent,lists#indent,links#modifylink,links#unlink,link#anchor,misctools#specialchars]">
                                                            </dialogFullScreen>
                                                    </cui>
                                                </uiSettings>
                                            </copyright>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </legal>
                    <links
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Links"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <homePage
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                    name="./homePage"
                                                    fieldLabel="Home Page Link"
                                                    fieldDescription="Link home page of current site"
                                                    rootPath="/content/solidigm"
                                                    required="{Boolean}true" />
                                            <facebook
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldDescription="URL of external Facebook page"
                                                    fieldLabel="Facebook Link"
                                                    required="{Boolean}true"
                                                    name="./facebook" />
                                            <linkedIn
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldDescription="URL of external LinkedIn page"
                                                    fieldLabel="LinkedIn Link"
                                                    required="{Boolean}true"
                                                    name="./linkedIn" />
                                            <twitter
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldDescription="URL of external Twitter page"
                                                    fieldLabel="Twitter Link"
                                                    required="{Boolean}true"
                                                    name="./twitter" />
                                            <youTube
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldDescription="URL of external YouTube page"
                                                    fieldLabel="YouTube Link"
                                                    required="{Boolean}true"
                                                    name="./youTube" />
                                            <trustArc
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldDescription="URL of external TrustArc page"
                                                    fieldLabel="TrustArc Link"
                                                    name="./trustArc" />
                                            <links
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                    composite="{Boolean}true"
                                                    fieldLabel="Links">
                                                <field
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/container"
                                                        name="./links">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <column
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <linkLabel
                                                                        jcr:primaryType="nt:unstructured"
                                                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                        fieldLabel="Label"
                                                                        required="{Boolean}true"
                                                                        name="./label" />
                                                                <linkPath
                                                                        jcr:primaryType="nt:unstructured"
                                                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                                        name="./link"
                                                                        fieldLabel="Link"
                                                                        fieldDescription="Link target page"
                                                                        rootPath="/content/solidigm"
                                                                        required="{Boolean}true" />
                                                            </items>
                                                        </column>
                                                    </items>
                                                </field>
                                            </links>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </links>
                </items>
            </tabview>
        </items>
    </content>
</jcr:root>