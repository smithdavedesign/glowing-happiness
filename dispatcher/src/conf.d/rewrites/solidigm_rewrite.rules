# Synergy Page Rules /Synergy.html
RewriteCond %{REQUEST_URI} ^/synergy(\.html)?$ [NC]
RewriteCond %{SERVER_NAME} ^.*\.com$
RewriteRule ^.*$ /content/solidigm/us/en/products/client/synergy.html [PT,L]

RewriteCond %{REQUEST_URI} ^/synergy(\.html)?$ [NC]
RewriteCond %{SERVER_NAME} ^.*\.kr$
RewriteRule ^.*$ /content/solidigm/kr/ko/products/client/synergy.html [PT,L]

