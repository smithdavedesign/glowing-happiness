## VYRKCIN-197 allow productcompare servlet requests through without any
## mutation of the request.
## IF request path contains /_jcr_content (i.e. is a selector servlet)
## AND request path contains productcompare
## AND request path contains .json
## THEN consider this a request for selector servlet, so, let the request through without modification.
RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{REQUEST_URI} .*/_jcr_content.*
RewriteCond %{REQUEST_URI} .*productcompare.*
RewriteCond %{REQUEST_URI} .*json.*
RewriteRule ^/(.*)$ /$1 [PT,L]


## VYRKCIN-368 mapping GET requests for newco-aem-site site content pages that use fully qualified content paths but
## do not have the .html extensions present
## VYRKCIN-409 ignore requests containing _jcr_content
RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{REQUEST_URI} !^/.*.html$
RewriteCond %{REQUEST_URI} !.*/_jcr_content.*
RewriteCond %{REQUEST_URI} ^/content/newco-aem-site
RewriteRule ^/(.*)$ /$1.html [PT,L]


# VYRKCIN-368 account for shortened, extensionless page requests by adding the .html extension and
# the /content/newco-aem-site/language-masters prefix here in the web server
# is a GET request
# is missing the .html extension
# already shortend (meaning no /content/newco-aem-site/language-masters prefixes present)
## VYRKCIN-409 ignore requests containing _jcr_content
RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{REQUEST_URI} !^/.*.html$
RewriteCond %{REQUEST_URI} !.*/_jcr_content.*
RewriteCond %{REQUEST_URI} !^/etc
RewriteCond %{REQUEST_URI} !^/var
RewriteCond %{REQUEST_URI} !^/apps
RewriteCond %{REQUEST_URI} !^/siteadmin
RewriteCond %{REQUEST_URI} !^/bin
RewriteCond %{REQUEST_URI} !^/libs
RewriteCond %{REQUEST_URI} !^/home
RewriteCond %{REQUEST_URI} !^/content/dam
RewriteCond %{REQUEST_URI} !^/author
RewriteCond %{REQUEST_URI} !^/system
RewriteCond %{REQUEST_URI} !^/conf
RewriteRule ^/(.*)$ /content/newco-aem-site/language-masters/$1.html [PT,L]



## VYRKCIN-368 mapping GET shortened path requests for site content pages with .html extensions present
## from the shortened user-friendly paths expanded to full content paths internally.
RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{REQUEST_URI} ^/.*.html$
RewriteCond %{REQUEST_URI} !^/apps
RewriteCond %{REQUEST_URI} !^/content
RewriteCond %{REQUEST_URI} !^/etc
RewriteCond %{REQUEST_URI} !^/libs
RewriteCond %{REQUEST_URI} !^/bin
RewriteCond %{REQUEST_URI} !^/tmp
RewriteCond %{REQUEST_URI} !^/var
RewriteCond %{REQUEST_URI} !^/crx
RewriteCond %{REQUEST_URI} !^/system
RewriteCond %{REQUEST_URI} !^/dispatcher
RewriteRule ^/(.*)$ /content/newco-aem-site/language-masters/$1 [PT,L]

## VYRKCIN-409 support expanding shortened image requests stored under _jcr_content
## from the shortened user-friendly paths expanded to full content paths internally.
## GET request
## does not end with .html
## does not start with /content
## contains /_jcr_content
RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{REQUEST_URI} !^/.*.html$
RewriteCond %{REQUEST_URI} !^/content
RewriteCond %{REQUEST_URI} .*/_jcr_content.*
RewriteRule ^/(.*)$ /content/newco-aem-site/language-masters/$1 [PT,L]
