RewriteCond %{REQUEST_URI} ^/support(\.html)?$ [NC]
RewriteCond %{SERVER_NAME} ^.*\.de$
RewriteRule ^.*$ /content/solidigm/de/de/support-page.html [PT,L]

RewriteCond %{REQUEST_URI} ^/support-page(\.html)?$ [NC]
RewriteCond %{SERVER_NAME} ^.*\.com$
RewriteRule ^.*$ /content/solidigm/us/en/support-page.html [PT,L]

# AEM Core Component XML sitemap
RewriteCond %{REQUEST_URI} ^/sitemap(\.xml)?$ [NC]
RewriteCond %{SERVER_NAME} ^.*\.com$
# RewriteRule ^.*$ /content/solidigm/us/en.sitemap.xml [PT,L]
RewriteRule ^.*$ /content/solidigm/us/en/sitemap.xml [PT,L]

RewriteCond %{REQUEST_URI} ^/sitemap(\.xml)?$ [NC]
RewriteCond %{SERVER_NAME} ^.*\.kr$
# RewriteRule ^.*$ /content/solidigm/kr/ko.sitemap.xml [PT,L]
