<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          jcr:primaryType="nt:unstructured"
          jcr:title="Video"
          sling:resourceType="cq/gui/components/authoring/dialog"
          extraClientlibs="[core.wcm.components.embed.v1.editor]"
          helpPath="https://www.adobe.com/go/aem_cmp_embed_v2"
          trackingFeature="core-components:embed:v2">

    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                size="L">
                <items jcr:primaryType="nt:unstructured">
                    <urlTab
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Video Link"
                        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                        <items jcr:primaryType="nt:unstructured">
                            <column
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <video
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldDescription="The URL of the youtube video to embed"
                                        fieldLabel="Youtube URL"
                                        emptyText="URL to youtube video"
                                        name="./url" />
                                    <brightcoveId
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldDescription="The URL of the Brightcove video to embed"
                                        fieldLabel="Brightcove video ID"
                                        emptyText="Brightcove video ID"
                                        name="./brightcoveId" />
                                </items>
                            </column>
                        </items>
                    </urlTab>
                    <thumbnailTab
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Thumbnail Image"
                        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                        <items jcr:primaryType="nt:unstructured">
                            <column
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <thumbnailImage
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                        autoStart="{Boolean}false"
                                        class="cq-droptarget"
                                        fileNameParameter="./thumbnailImageName"
                                        fileReferenceParameter="./thumbnailImageReference"
                                        mimeTypes="[image/gif,image/jpeg,image/png,image/tiff,image/svg+xml]"
                                        name="./thumbnailImage"
                                        uploadUrl="${suffix.path}"
                                        useHTML5="{Boolean}true"
                                        required="{Boolean}true" />
                                    <thumbnailAltText
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Thumbnail Image Alt Text"
                                        emptyText="Leave blank to use the Alt Text stored in the DAM"
                                        name="./thumbnailAltText" />
                                </items>
                            </column>
                        </items>
                    </thumbnailTab>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>