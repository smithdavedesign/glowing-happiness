<?xml version="1.0" encoding="UTF-8"?>
<jcr:root
        xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
        xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
        xmlns:cq="http://www.day.com/jcr/cq/1.0"
        xmlns:jcr="http://www.jcp.org/jcr/1.0"
        xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
        jcr:primaryType="nt:unstructured"
        jcr:title="Product Configurator"
        sling:resourceType="cq/gui/components/authoring/dialog">
        <content
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                        <tabs
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                                maximized="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                        <byTheNumbers
                                                jcr:primaryType="nt:unstructured"
                                                jcr:title="By the Numbers"
                                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                                margin="{Boolean}true">
                                                <items jcr:primaryType="nt:unstructured">
                                                        <columns
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                                                margin="{Boolean}true">
                                                                <items jcr:primaryType="nt:unstructured">
                                                                        <column
                                                                                jcr:primaryType="nt:unstructured"
                                                                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                                                                <items jcr:primaryType="nt:unstructured">
                                                                                        <attributes
                                                                                                jcr:primaryType="nt:unstructured"
                                                                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                                                                composite="{Boolean}true"
                                                                                                fieldLabel="Attributes"
                                                                                                fieldDescription="List of product attributes.">
                                                                                                <field
                                                                                                        jcr:primaryType="nt:unstructured"
                                                                                                        sling:resourceType="granite/ui/components/coral/foundation/container"
                                                                                                        name="./attributes">
                                                                                                        <items jcr:primaryType="nt:unstructured">
                                                                                                                <column
                                                                                                                        jcr:primaryType="nt:unstructured"
                                                                                                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                                                                                                        <items jcr:primaryType="nt:unstructured">
                                                                                                                                <attribute
                                                                                                                                        jcr:primaryType="nt:unstructured"
                                                                                                                                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                                                                                                        fieldLabel="Attribute"
                                                                                                                                        fieldDescription="Select the attribute to display"
                                                                                                                                        required="{Boolean}true"
                                                                                                                                        name="./attribute">
                                                                                                                                        <items jcr:primaryType="nt:unstructured">
                                                                                                                                                <CertifiedUseConditions jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="CertifiedUseConditions"
                                                                                                                                                     text="Use Conditions"/>
                                                                                                                                                <DriveCapacity jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="DriveCapacity"
                                                                                                                                                     text="Capacity"/>
                                                                                                                                                <EnduranceDWPD jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="EnduranceDWPD"
                                                                                                                                                     text="Endurance Rating (Lifetime Writes)"/>
                                                                                                                                                <EndurancePBW jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="EndurancePBW"
                                                                                                                                                     text="Endurance Rating (Lifetime Writes)"/>
                                                                                                                                                <SSDEnduranceRating jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="SSDEnduranceRating"
                                                                                                                                                     text="Endurance Rating (Lifetime Writes)"/>
                                                                                                                                                <Filter-UseConditions jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="Filter-UseConditions"
                                                                                                                                                     text="Use Conditions"/>
                                                                                                                                                <FIPSVersion jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="FIPSVersion"
                                                                                                                                                     text="FIPS Version"/>
                                                                                                                                                <LatencyRandomRead jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="LatencyRandomRead"
                                                                                                                                                     text="Latency - Random Read (typ.)"/>
                                                                                                                                                <LatencyRandomWriteValue jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="LatencyRandomWriteValue"
                                                                                                                                                     text="Latency - Random Write (typ.)"/>
                                                                                                                                                <LatencySequentialRead jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="LatencySequentialRead"
                                                                                                                                                     text="Latency - Sequential Read (typ.)"/>
                                                                                                                                                <LatencySequentialWriteValue jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="LatencySequentialWriteValue"
                                                                                                                                                     text="Latency - Sequential Write (typ.)"/>
                                                                                                                                                <LithographyType jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="LithographyType"
                                                                                                                                                     text="Lithography Type"/>
                                                                                                                                                <MTBF jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="MTBF"
                                                                                                                                                     text="Mean Time Between Failures (MTBF)"/>
                                                                                                                                                <NANDGeneration jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="NANDGeneration"
                                                                                                                                                     text="NAND Generation"/>
                                                                                                                                                <NANDLayerCount jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="NANDLayerCount"
                                                                                                                                                     text="NAND Layer Count"/>
                                                                                                                                                <NANDTechnology jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="NANDTechnology"
                                                                                                                                                     text="NAND Technology"/>
                                                                                                                                                <NANDType jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="NANDType"
                                                                                                                                                     text="NAND Type"/>
                                                                                                                                                <NVMeVersion jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="NVMeVersion"
                                                                                                                                                     text="NVMe Version"/>
                                                                                                                                                <OCPVersion jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="OCPVersion"
                                                                                                                                                     text="OCP Version"/>
                                                                                                                                                <OpalVersion jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="OpalVersion"
                                                                                                                                                     text="Opal Version"/>
                                                                                                                                                <OperatingTemperature jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="OperatingTemperature"
                                                                                                                                                     text="Operating Temperature Range"/>
                                                                                                                                                <ProductGroup jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="ProductGroup"
                                                                                                                                                     text="Product Collection"/>
                                                                                                                                                <RandomRead100PctSpanValue jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="RandomRead100PctSpanValue"
                                                                                                                                                     text="Random Read (100% Span)"/>
                                                                                                                                                <RandomWrite100PctSpanValue jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="RandomWrite100PctSpanValue"
                                                                                                                                                     text="Random Write (100% Span)"/>
                                                                                                                                                <SequentialReadMB jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="SequentialReadMB"
                                                                                                                                                     text="Sequential Bandwidth - 100% Read (up to)"/>
                                                                                                                                                <SequentialWriteMB jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="SequentialWriteMB"
                                                                                                                                                     text="Sequential Bandwidth - 100% Write (up to)"/>
                                                                                                                                                <SSDEnduranceRating jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="SSDEnduranceRating"
                                                                                                                                                     text="Endurance Rating (Lifetime Writes)"/>
                                                                                                                                                <SSDFormFactor jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="SSDFormFactor"
                                                                                                                                                     text="Form Factor"/>
                                                                                                                                                <SSDInterface jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="SSDInterface"
                                                                                                                                                     text="Interface"/>
                                                                                                                                                <SSDPowerActive jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="SSDPowerActive"
                                                                                                                                                     text="Power - Active"/>
                                                                                                                                                <SSDPowerIdle jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="SSDPowerIdle"
                                                                                                                                                     text="Power - Idle"/>
                                                                                                                                                <SSDShock jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="SSDShock"
                                                                                                                                                     text="Shock (Operating and Non-Operating)"/>
                                                                                                                                                <SSDWeight jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="SSDWeight"
                                                                                                                                                     text="Weight"/>
                                                                                                                                                <UBER jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="UBER"
                                                                                                                                                     text="Uncorrectable Bit Error Rate (UBER)"/>
                                                                                                                                                <VibrationNonOperating jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="VibrationNonOperating"
                                                                                                                                                     text="Vibration - Non-Operating"/>
                                                                                                                                                <VibrationOperating jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="VibrationOperating"
                                                                                                                                                     text="Vibration - Operating"/>
                                                                                                                                                <WarrantyLengthYears jcr:primaryType="nt:unstructured"
                                                                                                                                                     value="WarrantyLengthYears"
                                                                                                                                                     text="Warranty Period"/>

                                                                                                                                        </items>
                                                                                                                                </attribute>
                                                                                                                                <attributeValue
                                                                                                                                        jcr:primaryType="nt:unstructured"
                                                                                                                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                                                                                        fieldDescription="If left blank will grab the attribute from product data"
                                                                                                                                        fieldLabel="Attribute Value"
                                                                                                                                        emptyText="Leave blank to automatically populate from product data"
                                                                                                                                        name="./attributeValue" />
                                                                                                                        </items>
                                                                                                                </column>
                                                                                                        </items>
                                                                                                </field>
                                                                                        </attributes>
                                                                                        <highlights
                                                                                                jcr:primaryType="nt:unstructured"
                                                                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                                                                composite="{Boolean}true"
                                                                                                fieldLabel="Highlights">
                                                                                                <field
                                                                                                        jcr:primaryType="nt:unstructured"
                                                                                                        sling:resourceType="granite/ui/components/coral/foundation/container"
                                                                                                        name="./highlights">
                                                                                                        <items jcr:primaryType="nt:unstructured">
                                                                                                                <column
                                                                                                                        jcr:primaryType="nt:unstructured"
                                                                                                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                                                                                                        <items jcr:primaryType="nt:unstructured">
                                                                                                                                <heading
                                                                                                                                        jcr:primaryType="nt:unstructured"
                                                                                                                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                                                                                        fieldDescription="It is recommended to keep the heading extremely short."
                                                                                                                                        fieldLabel="Heading"
                                                                                                                                        required="{Boolean}true"
                                                                                                                                        name="./heading" />
                                                                                                                                <description
                                                                                                                                        sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                                                                                                        jcr:primaryType="nt:unstructured"
                                                                                                                                        name="./description"
                                                                                                                                        required="{Boolean}true"
                                                                                                                                        fieldLabel="Description"
                                                                                                                                        rows="{Long}2" />
                                                                                                                        </items>
                                                                                                                </column>
                                                                                                        </items>
                                                                                                </field>
                                                                                        </highlights>
                                                                                </items>
                                                                        </column>
                                                                </items>
                                                        </columns>
                                                </items>
                                        </byTheNumbers>
                                        <download
                                                jcr:primaryType="nt:unstructured"
                                                jcr:title="Download"
                                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                                margin="{Boolean}true">
                                                <items jcr:primaryType="nt:unstructured">
                                                        <columns
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                                                margin="{Boolean}true">
                                                                <items jcr:primaryType="nt:unstructured">
                                                                        <column
                                                                                jcr:primaryType="nt:unstructured"
                                                                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                                                                <items jcr:primaryType="nt:unstructured">
                                                                                        <download
                                                                                                jcr:primaryType="nt:unstructured"
                                                                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                                                                name="./download"
                                                                                                fieldLabel="Download Link"
                                                                                                fieldDescription="Link or path to download resource"
                                                                                                rootPath="/content/dam/solidigm" />
                                                                                </items>
                                                                        </column>
                                                                </items>
                                                        </columns>
                                                </items>
                                        </download>
                                </items>
                        </tabs>
                </items>
        </content>
</jcr:root>