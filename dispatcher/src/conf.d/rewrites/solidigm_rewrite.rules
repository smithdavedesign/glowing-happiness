# handle multi language mySolidigm dashboard
RewriteCond %{REQUEST_URI} ^/my-solidigm$
RewriteCond %{SERVER_NAME} ^.*\.com$
RewriteRule ^.*$ /content/solidigm/us/en/my-solidigm.html [PT,L]

RewriteCond %{REQUEST_URI} ^/my-solidigm$
RewriteCond %{SERVER_NAME} ^.*\.kr$
RewriteRule ^.*$ /content/solidigm/kr/ko/my-solidigm.html [PT,L]

RewriteCond %{REQUEST_URI} ^/my-solidigm$
RewriteCond %{SERVER_NAME} ^.*\.cn$
RewriteRule ^.*$ /content/solidigm/cn/zh/my-solidigm.html [PT,L]

RewriteCond %{REQUEST_URI} ^/my-solidigm$
RewriteCond %{SERVER_NAME} ^.*\.jp$
RewriteRule ^.*$ /content/solidigm/jp/ja/my-solidigm.html [PT,L]

RewriteCond %{REQUEST_URI} ^/my-solidigm$
RewriteCond %{SERVER_NAME} ^.*\.de$
RewriteRule ^.*$ /content/solidigm/de/de/my-solidigm.html [PT,L]